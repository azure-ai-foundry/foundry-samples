# Foundry project endpoint. Auto-injected in hosted containers and by
# `azd ai agent run`. Set manually for local `dotnet run` / F5.
FOUNDRY_PROJECT_ENDPOINT=

# Model deployment name - must match a deployment in your Foundry project.
# Defaults to "gpt-5.4-mini" if unset.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
