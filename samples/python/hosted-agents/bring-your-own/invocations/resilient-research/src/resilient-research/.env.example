# Foundry project endpoint — auto-injected in hosted containers.
# Only set manually if running without `azd ai agent run`.
# When unset, the agent runs in OFFLINE demo mode (deterministic synthetic
# token streams, no credentials needed) so you can exercise the resilient,
# streaming, and steering control flow end to end.
# FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Model deployment name — must match a deployment in your Foundry project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Research shape / pacing (raise these to make the run genuinely long).
# NUM_PHASES=6
# CALLS_PER_PHASE=3
# TARGET_OUTPUT_TOKENS=800
# INTRA_PHASE_COOLDOWN_SEC=3
# INTER_PHASE_COOLDOWN_SEC=6

# Local-dev credential escape hatch: force AzureCliCredential only.
# AZURE_AI_CREDENTIAL=cli

# Application Insights — auto-injected in hosted containers.
# APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...
