{
    // Debug the activity-protocol echo agent locally with full Python breakpoint support.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug: Activity Agent (local)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "install deps",
            "postDebugTask": "Cleanup after debug"
        }
    ]
}
