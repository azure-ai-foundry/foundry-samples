# Option 1 - Foundry BYOK model (default)
# FOUNDRY_PROJECT_ENDPOINT is injected when hosted and configured automatically
# by `azd ai agent run`.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini

# Option 2 - GitHub Copilot model
# Comment the Foundry variables above and set a fine-grained PAT with
# "Copilot Requests: Read-only".
# GITHUB_TOKEN=
# GITHUB_COPILOT_MODEL=

# Optional persisted Copilot session identifier.
# FOUNDRY_AGENT_SESSION_ID=
