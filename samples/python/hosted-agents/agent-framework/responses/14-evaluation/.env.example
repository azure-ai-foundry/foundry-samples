# Required for the hosted agent itself
FOUNDRY_PROJECT_ENDPOINT="https://<account>.services.ai.azure.com/api/projects/<project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1-mini"

# Tracing is enabled by default in this sample so trace-driven evaluators
# (multi-turn-traces, scheduled, dataset-from-traces) work out of the box.
# Foundry injects APPLICATIONINSIGHTS_CONNECTION_STRING when deployed; set it
# yourself if you want telemetry from local runs.
ENABLE_INSTRUMENTATION=true
ENABLE_SENSITIVE_DATA=true
# APPLICATIONINSIGHTS_CONNECTION_STRING="InstrumentationKey=..."

# Used by the evaluate_*.py scripts to target your deployed hosted agent.
# Defaults match this sample (`agent-framework-agent-evaluation-responses`);
# override if you registered the agent under a different name/version.
EVAL_AGENT_NAME="agent-framework-agent-evaluation-responses"
EVAL_AGENT_VERSION="1"
