name: {agent_name}
description: LangGraph agent wired for Azure AI Foundry Toolset MCP.
metadata:
  tags:
    - AI Agent Hosting
    - LangGraph
template:
  name: {agent_name}
  kind: hosted
  protocols:
    - protocol: responses
      version: v1
  environment_variables:
    - name: AZURE_AI_PROJECT_ENDPOINT
      value: ${{AZURE_AI_PROJECT_ENDPOINT}}
    - name: AZURE_OPENAI_ENDPOINT
      value: ${{AZURE_OPENAI_ENDPOINT}}
    - name: MODEL_DEPLOYMENT_NAME
      value: ${{MODEL_DEPLOYMENT_NAME}}
    - name: AZURE_AI_TOOLSET_ENDPOINT
      value: ${{AZURE_AI_TOOLSET_ENDPOINT}}
    - name: AZURE_AI_TOOLSET_PROFILE
      value: ${{AZURE_AI_TOOLSET_PROFILE}}
resources:
  - kind: model
    id: gpt-4o
    name: chat
