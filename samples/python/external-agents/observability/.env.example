AZURE_SUBSCRIPTION_ID=<subscription-id>
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
RESOURCE_GROUP=<resource-group>
LOCATION=eastus2
ACA_ENV=<container-apps-environment>
ACR_NAME=<acr-name>
