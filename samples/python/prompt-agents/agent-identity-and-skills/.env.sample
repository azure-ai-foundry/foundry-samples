# Foundry project (from your 40-basic-agent-setup / infra deployment)
AZURE_AI_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# The sample OWNS its toolbox + connection: `provision_skills.py` creates a toolbox named
# "investment-skills" and an agent-identity (AgenticIdentityToken) connection
# "investment-skills-toolbox" that fronts its
# MCP endpoint. The connection id is derived from PROJECT_RESOURCE_ID (below) — nothing to set.

# Key Vault holding the profile-API credential (agent identity needs "Key Vault Secrets User")
KEYVAULT_URL=https://<vault>.vault.azure.net

# Profile API (Logic App) invoke URL WITHOUT the "&sig=..." part — the sig lives in Key Vault
FINANCIAL_PROFILE_URL=https://<logic-app-host>/workflows/<id>/triggers/<name>/paths/invoke?api-version=2016-10-01&sp=<...>&sv=1.0

# Holdings input: a blob in YOUR storage account (same tenant). The agent identity needs
# "Storage Blob Data Reader" on the container/account. Upload data/holdings.csv here first.
HOLDINGS_BLOB_URL=https://<account>.blob.core.windows.net/<container>/holdings.csv

# Resource IDs of the Azure resources the AGENT identity is granted access to.
# PROJECT_RESOURCE_ID is required early (provision_skills.py derives the toolbox connection id
# from it, and `main.py create` references that connection). KEYVAULT/STORAGE are used by
# `python main.py grant` for the post-create RBAC step. `az resource show`/portal give these.
KEYVAULT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.KeyVault/vaults/<vault>
STORAGE_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.Storage/storageAccounts/<account>
PROJECT_RESOURCE_ID=/subscriptions/<sub>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
