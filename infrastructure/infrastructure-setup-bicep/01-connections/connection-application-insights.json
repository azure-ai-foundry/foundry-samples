{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "10846213492702673542"
    }
  },
  "parameters": {
    "aiFoundryName": {
      "type": "string",
      "defaultValue": "<your-account-name>"
    },
    "aiProjectName": {
      "type": "string",
      "defaultValue": "<your-project-name>",
      "metadata": {
        "description": "Name of the project (sub-resource of the AI Foundry account) to create the connection on."
      }
    },
    "connectedResourceName": {
      "type": "string",
      "defaultValue": "[format('appi{0}', parameters('aiFoundryName'))]"
    },
    "location": {
      "type": "string",
      "defaultValue": "westus"
    },
    "isSharedToAll": {
      "type": "bool",
      "defaultValue": true
    },
    "newOrExisting": {
      "type": "string",
      "defaultValue": "new",
      "allowedValues": [
        "new",
        "existing"
      ]
    },
    "roleDefinitionGuids": {
      "type": "array",
      "defaultValue": [
        "73c42c96-874c-492b-b04d-ab87d138a893",
        "dbc9c667-e97f-4491-aee6-90b9cf960190"
      ]
    }
  },
  "resources": [
    {
      "condition": "[equals(parameters('newOrExisting'), 'new')]",
      "type": "Microsoft.Insights/components",
      "apiVersion": "2020-02-02",
      "name": "[parameters('connectedResourceName')]",
      "location": "[parameters('location')]",
      "kind": "web",
      "properties": {
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/connections",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}', parameters('aiFoundryName'), format('{0}-appinsights', parameters('aiFoundryName')))]",
      "properties": {
        "category": "AppInsights",
        "target": "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]",
        "authType": "ApiKey",
        "isSharedToAll": "[parameters('isSharedToAll')]",
        "credentials": {
          "key": "[reference(resourceId('Microsoft.Insights/components', parameters('connectedResourceName')), '2020-02-02').ConnectionString]"
        },
        "metadata": {
          "ApiType": "Azure",
          "ResourceId": "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects/connections",
      "apiVersion": "2025-04-01-preview",
      "name": "[format('{0}/{1}/{2}', parameters('aiFoundryName'), parameters('aiProjectName'), parameters('connectedResourceName'))]",
      "properties": {
        "category": "AppInsights",
        "target": "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]",
        "authType": "ApiKey",
        "isSharedToAll": "[parameters('isSharedToAll')]",
        "credentials": {
          "key": "[reference(resourceId('Microsoft.Insights/components', parameters('connectedResourceName')), '2020-02-02').ConnectionString]"
        },
        "metadata": {
          "ApiType": "Azure",
          "ResourceId": "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]"
      ]
    },
    {
      "copy": {
        "name": "appInsightsReaderRoleAssignments",
        "count": "[length(parameters('roleDefinitionGuids'))]"
      },
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('aiFoundryName'), parameters('aiProjectName')), parameters('roleDefinitionGuids')[copyIndex()], resourceId('Microsoft.Insights/components', parameters('connectedResourceName')))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('aiFoundryName'), parameters('aiProjectName')), '2025-04-01-preview', 'full').identity.principalId]",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', parameters('roleDefinitionGuids')[copyIndex()])]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Insights/components', parameters('connectedResourceName'))]"
      ]
    }
  ]
}